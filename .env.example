# ==============================================================================
# Stock Market Data Pipeline Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your real .env file or API keys to version control.
# ==============================================================================

# Alpha Vantage Free Tier API Key (Get one at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=YOUR_API_KEY

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpassword

# Comma-separated list of stock tickers to monitor
STOCK_SYMBOLS=AAPL,MSFT,GOOGL

# Airflow Webserver Admin Credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
